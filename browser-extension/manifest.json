{
  "manifest_version": 3,
  "name": "抗体图谱助手 (Antibody Map Helper)",
  "version": "1.0.0",
  "description": "在浏览器中查看文献或网页时，一键添加到抗体图谱项目数据库并触发 AI 数据提取。参考 Mendeley 浏览器插件。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "抗体图谱助手 - 添加当前文献到数据库",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:8000/*",
    "http://localhost:8080/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8080/*"
  ]
}
