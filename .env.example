# LLM 配置（必填 — 至少配置 LLM_API_KEY）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 默认推荐 deepseek-flash（当前对应 DeepSeek-V4.1-Flash）。
# 旧模型名 deepseek-chat / deepseek-reasoner 已被官方弃用，但代码仍兼容可继续使用。
LLM_MODEL=deepseek-flash

# LLM — 按模型厂商独立配置（可选，未配置时回退到上面的 LLM_API_KEY / LLM_BASE_URL）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM — 连接容错配置
# 主 LLM_BASE_URL 连接失败时的备用地址（逗号分隔，可选）。
# 场景：WSL 重启导致 Ollama 网关 IP 漂移 / 远程 API 短暂不可达时自动切换。
# 例：LLM_FALLBACK_BASE_URLS=http://172.27.96.1:11434/v1,http://host.docker.internal:11434/v1
# LLM_FALLBACK_BASE_URLS=
# 连接类错误（DNS/连接/超时）的快速重试次数（短退避 2s/5s），仅作用于连接错误，不消耗 token
# LLM_CONNECT_RETRIES=2

# LLM — 并发提取配置（B1 优化）
# 并发请求数上限，需与 Ollama 的 OLLAMA_NUM_PARALLEL 环境变量对齐（默认 4）
# LLM_CONCURRENCY=4
# docker-compose 中 worker 的 Ollama 并发数（建议 =1，保证 qwen3.8:27b 等大模型 100% GPU 常驻）
# OLLAMA_NUM_PARALLEL=1
# 长文档分块阈值（字符数，超过此值触发分块并发提取）
# LLM_CHUNK_THRESHOLD=20000
# LLM_CHUNK_SIZE=15000
# LLM_CHUNK_OVERLAP=500
# 文本预处理最大保留字符数（须 > LLM_CHUNK_THRESHOLD）
# TEXT_PREPROCESS_MAX_CHARS=600000

# 孤儿文件清理 — 定时清理 backend/data/pdfs 中已不在数据库的残留文献文件
# 清理策略：孤儿文件先移入回收目录（默认 backend/data/pdf_orphan_trash），保留
# ORPHAN_TRASH_RETENTION_DAYS 天后自动物理删除，避免误删不可恢复。
# ORPHAN_CLEANUP_ENABLED=true
# 后台定时清理间隔（秒），默认每天一次（86400）
# ORPHAN_CLEANUP_INTERVAL=86400
# 回收目录（可选，默认 backend/data/pdf_orphan_trash；可指定绝对路径）
# ORPHAN_TRASH_DIR=
# 回收目录保留天数，超过后自动物理删除，默认 30
# ORPHAN_TRASH_RETENTION_DAYS=30

# PubMed 开放获取 PDF 下载目录（可选，为空时回退到文献存储目录 LOCAL_STORAGE_DIR）
# PDF_DOWNLOAD_DIR=

# 数据库 (使用 openssl rand -base64 24 生成密码，替换 <generated_password>)
# - 本地开发直连 postgres（Windows 本机装 pg 客户端 / DBeaver 等）：host=localhost
# - docker compose 容器内 backend/worker 无需显式设置，compose 会注入 host=postgres 的版本
# DATABASE_URL=postgresql+asyncpg://antibody:<generated_password>@localhost:5432/antibody_map

# Redis
# REDIS_URL=redis://:<password>@localhost:6379/0
# REDIS_PASSWORD=

# Postgres 密码（使用 openssl rand -base64 24 生成，需与 DATABASE_URL 一致）
# POSTGRES_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=antibody
# MinIO root 密码（使用 openssl rand -base64 24 生成）
# MINIO_ROOT_PASSWORD=
MINIO_BUCKET_LITERATURE=antibody-literature

# Celery（使用 Redis 密码，需与 REDIS_PASSWORD 一致）
# 注意：CELERY_BROKER_URL 和 CELERY_RESULT_BACKEND 的 Redis 密码需与上方 REDIS_PASSWORD 保持一致
# CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1
# CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@localhost:6379/2

# OCR - Tesseract 路径（可选，不配置时自动探测 PATH 或 Windows 常见安装位置）
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_DATA_DIR=C:\Users\admin\AppData\Local\Tesseract-OCR\tessdata

# App
# SECRET_KEY 用于加密存储远程模型 API Key（Fernet 对称加密）
# 必须配置，长度 >= 32 字符，可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
SECRET_KEY=
APP_ENV=development
APP_DEBUG=False
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_UPLOAD_SIZE=52428800

# V2-03: 知识图谱问答是否纳入未审核数据点。默认 false（只检索 review_status='approved'）
# 生产科研口径建议保持 false；显式设 true 才纳入 pending/rejected
# KG_QA_INCLUDE_UNREVIEWED=false

# 默认 admin 管理员口令（v1.33.0 新增）
# 生产部署**必须**设置 ≥12 位；未设置时回退旧默认值 myk123456（启动日志 warning）
# 示例：DEFAULT_ADMIN_PASSWORD=ChangeMePlease123
# DEFAULT_ADMIN_PASSWORD=

# Grafana 仪表盘管理员密码（必填 — 使用 openssl rand -base64 24 生成）
# GRAFANA_ADMIN_PASSWORD=

# 文件夹监控宿主机路径（可选，不配置则使用 docker-compose.yml 默认值）
# MONITORED_REF_HOST_PATH=/mnt/e/01-liuxiong/antibody_map_ref/ref

# ============================================================
# 以下为补充字段（config.py Settings 存在但 .env.example 未文档化）
# 默认值来自 config.py，注释说明可配置场景
# ============================================================

# --- LLM 扩展厂商 (Ollama 本地模型) ---
# OLLAMA_API_KEY=ollama   # 占位 key (Ollama 不校验)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- LLM 提取核心参数 ---
# 提取通过次数 (N=2 双阶段)
# LLM_EXTRACTION_PASSES=2
# Crossref DOI 自动回填
# CROSSREF_DOI_BACKFILL=true
# 请求整体超时 (秒)
# LLM_REQUEST_TIMEOUT=1200
# 首 token 超时 (秒)
# LLM_FIRST_TOKEN_TIMEOUT=60
# chunk 之间等待上限 (秒)
# LLM_CHUNK_GAP_TIMEOUT=120
# 上下文窗口 token 数 (须 >= MAX_TOKENS)
# LLM_CTX_TOKENS=16384
# 最大输出 token 数
# LLM_MAX_TOKENS=16384
# LLM_NUM_CTX=16384       # 同 CTX_TOKENS 的别名
# LLM_MAX_OUTPUT_TOKENS=4096
# 文本预处理最大保留字符
# TEXT_PREPROCESS_MAX_CHARS=600000

# --- LLM 并发与容错 ---
# 单任务并发请求数
# LLM_CONCURRENCY=1
# 单任务 token 硬上限 (0=不限制)
# LLM_MAX_TOKENS_PER_TASK=0
# 每日 token 配额 (0=不限制)
# LLM_DAILY_QUOTA=0
# 全局并发数上限 (跨 worker)
# LLM_GLOBAL_CONCURRENCY=0
# 连接类错误快速重试次数
# LLM_CONNECT_RETRIES=2
# 多模型合成超时 (秒)
# SYN_MULTI_MODEL_TIMEOUT=1800

# --- LLM 分块提取 ---
# 长文档分块阈值 (字符数)
# LLM_CHUNK_THRESHOLD=10000
# 分块大小 (字符数)
# LLM_CHUNK_SIZE=8000
# 分块重叠 (字符数)
# LLM_CHUNK_OVERLAP=800

# --- LLM 模型选择 (自适应复杂度) ---
# LLM_MODEL_LIGHT=        # 简单文献用 (短文本+无表格), 如 deepseek-flash
# LLM_MODEL_STRONG=       # 复杂文献用 (长文本+复杂表格), 如 deepseek-v4-pro
# LLM_TABLE_FIRST_EXTRACTION=true
# LLM_TWO_PHASE_EXTRACTION=false
# LLM_ADAPTIVE_PASSES=true

# --- LLM 反馈增强 (Few-Shot) ---
# LLM_FEEDBACK_FEW_SHOT=true
# LLM_FEEDBACK_FEW_SHOT_COUNT=5

# --- PDF 解析器 (选装) ---
# MinerU 多模态 PDF 解析 (需 pip install magic-pdf)
# ENABLE_MINERU_PDF_PARSER=false
# MINERU_PARSE_TIMEOUT=600
# Anydoc 加速解析
# ENABLE_ANYDOC=false
# ANYDOC_TIMEOUT=60
# PDF Inspector 内置表格检测
# ENABLE_PDF_INSPECTOR=true
# VL_BATCH_SIZE=6

# --- 知识图谱 ---
# ENABLE_KG_EXTRACTION=false

# --- Grounding 溯源 ---
# 模糊匹配阈值 (0.0-1.0)
# GROUNDING_FUZZY_THRESHOLD=0.72
# 未溯源数据自动 LLM reground
# GROUNDING_LLM_REGROUND=true

# --- 提取缓存 ---
# EXTRACTION_CACHE_ENABLED=true
# EXTRACTION_CACHE_TTL_HOURS=168

# --- 提取超时与心跳 ---
# 提取任务 stale 超时 (分钟)
# EXTRACTION_STALE_MINUTES=180
# 心跳发送间隔 (秒)
# EXTRACTION_HEARTBEAT_INTERVAL=60
# 心跳丢失判定超时 (分钟)
# EXTRACTION_HEARTBEAT_STALE_MINUTES=5

# --- Snapshot 分析快照 ---
# SNAPSHOT_TTL_DAYS=30
# SNAPSHOT_CLEANUP_INTERVAL=86400

# --- 备份 ---
# BACKUP_DIR=/app/backend/backups
# BACKUP_TIMEOUT=300
# AUTO_BACKUP_ENABLED=true
# AUTO_BACKUP_INTERVAL_MINUTES=60
# AUTO_BACKUP_KEEP_LAST=48

# --- 孤儿清理补充 ---
# ORPHAN_AUTO_MOVE=false
# ORPHAN_COOLING_DAYS=7
# TRASH_AUTO_CLEAN_ENABLED=false

# --- 元分析 / 免疫指标 ---
# MIN_STUDIES_FOR_META=2
# MIN_SAMPLE_FOR_META=30
# IMMUNITY_MC_SAMPLES=1000

# --- Security ---
# CRYPTO_KEY=
# TRUSTED_PROXIES=["127.0.0.1","::1"]
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW=60

# --- CORS ---
# CORS_ALLOW_CREDENTIALS=true

# --- Metrics ---
# METRICS_ENABLED=true
# METRICS_ALLOW_IPS=

# --- MinIO 补充 ---
# MINIO_SECRET_KEY=

# --- Celery 补充 ---
# CELERY_QUEUES=celery

# --- App ---
# APP_VERSION=    # 自动检测 (git tag / package.json), 可显式覆盖
