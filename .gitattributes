# 统一使用 LF 换行符（Git 仓库标准格式，解决 Windows CRLF 导致的假 diff）
* text=auto eol=lf

# PowerShell 脚本在 Windows 下使用 CRLF（系统原生）
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件：不做任何换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
*.pfb binary
*.bcmap binary
*.woff binary
*.woff2 binary
*.sql.gz binary
